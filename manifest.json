{
  "manifest_version": 3,
  "name": "圖片即譯",
  "version": "1.1.0",
  "description": "把網頁圖片裡的文字直接翻成你的語言，譯文疊在原圖上。針對 X / Twitter 最佳化。",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "圖片即譯"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "translate-hovered": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "翻譯滑鼠所在的圖片"
    },
    "toggle-auto": {
      "suggested_key": { "default": "Alt+A" },
      "description": "開關自動翻譯"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
